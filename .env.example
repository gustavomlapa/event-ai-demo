# ==============================================================================
# Tech Battle Royale - Environment Configuration
# ==============================================================================

# Google Cloud Project Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
SERVICE_NAME=tech-battle-royale

# Server Port (Cloud Run automatically sets PORT=8080)
PORT=8080

# Firestore Configuration
# Default database is usually '(default)'
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_COLLECTION_PREFIX=tbr_

# Local Development / Offline Testing
# Set to 'true' to use an in-memory mock for Firestore (perfect for offline demos/tests)
USE_LOCAL_MOCK=false

# Optional Admin Key (for securing presenter controls if exposed publicly)
ADMIN_SECRET=tech-clash-live-2026

